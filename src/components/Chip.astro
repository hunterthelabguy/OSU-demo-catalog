---
// Status, condition, and hazard chips. The accent color appears here and
// nowhere else (spec section 6). Chips never rely on color alone: every chip
// carries its text label and a border, so grayscale printing and color
// blindness lose nothing.
//
// Every tone is outlined. Since amendment 18 the alert chip is a filled
// accent with bold --on-accent text (4.56:1); tests/theme-contrast.test.ts
// asserts the pair.
interface Props {
  label: string;
  // stamp: accent outline, uppercase. The status chip, worn like an
  //   inspection stamp.
  // stamp-muted: the stamp for stubs. A stub is not a claim, so it does
  //   not wear the accent.
  // alert: bold on-accent text on an accent fill. Hazards, out_of_service,
  //   needs_repair, inaccessible.
  // neutral: ink outline. Everything informational.
  tone: 'stamp' | 'stamp-muted' | 'alert' | 'neutral';
}
const { label, tone } = Astro.props;
---

<span class={`chip chip-${tone}`}>{label}</span>

<style>
  .chip {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1;
    padding: 0.3em 0.55em;
    border-radius: 2px;
    white-space: nowrap;
  }
  .chip-stamp,
  .chip-stamp-muted,
  .chip-alert {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }
  .chip-stamp {
    /* ink text with an accent border: chip text is small, and the raw
       accent misses AA on the paper ground. See theme.css. */
    color: var(--ink);
    border: 1.5px solid var(--accent);
  }
  .chip-stamp-muted {
    color: var(--muted);
    border: 1.5px solid var(--muted);
  }
  .chip-alert {
    color: var(--on-accent);
    background: var(--accent);
    font-weight: 700;
    border: 1.5px solid var(--accent);
  }
  .chip-neutral {
    color: var(--ink);
    border: 1px solid var(--muted);
  }
  @media print {
    .chip-alert {
      color: var(--ink);
      background: none;
      border-color: var(--ink);
      font-weight: 600;
    }
    .chip-stamp,
    .chip-stamp-muted {
      color: var(--ink);
      border-color: var(--ink);
    }
  }
</style>
