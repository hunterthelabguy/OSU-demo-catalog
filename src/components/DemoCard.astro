---
// The demo card, spec section 6's signature element, as a row (build-plan
// amendment 21, superseding amendment 12's tile and amendment 13's
// photo-free compact card). One shape at every width: a square photo
// beside the prose, one card per row. Desktop: 160px photo (or a quiet
// "No photograph yet" panel), then title, summary clamped to three lines
// (amendment 16), classification line, and a footer of location and
// courses. Phone: the same card shrunk to a 64px thumbnail, no summary, no
// stub marker, and a photo-less card is text only. Room requirement and
// status chips left the card by amendment 21; room needs live on the
// detail page and the hide-stubs toggle carries status. Hazards are a
// top-right corner badge, absolutely placed so a hazard never changes card
// height: names at desktop, icon only on phone with the names as its
// accessible label (amendment 21's recorded exception to "chips always
// carry text"). Every facet value rides the card as data-* attributes; the
// index page script toggles visibility, so this component is the only
// source of card markup. `data-hazards` is not a facet (amendment 15).
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Chip from './Chip.astro';
import { joinValues, sortCourses, timeBuckets } from '../lib/facets';
import { humanize } from '../lib/format';

interface Props {
  demo: CollectionEntry<'demos'>;
}
const { demo } = Astro.props;
const d = demo.data;
const photo = d.images[0];

// Topics carry the physics, tags carry the apparatus-speak; one muted line,
// topics first. Tags are searchable prose, never a facet (amendment 10).
const classLine = [
  d.topics.map(humanize).join(', '),
  d.tags.length > 0 ? d.tags.join(', ') : null,
]
  .filter(Boolean)
  .join(' · ');

// The footer answers "where is it, which course": location left, courses
// right. Location stays on every card at every width (amendment 21), so
// a record without one says so plainly rather than dropping the row.
const locationText = d.location
  ? [d.location.room, d.location.shelf].filter(Boolean).join(' · ')
  : null;
const courses = sortCourses(d.course_tags);

// The badge's visible names and its accessible label are one string.
const hazardNames = d.hazards.map(humanize).join(' · ');
---

<article
  class={`card ${d.hazards.length > 0 ? 'has-hazard' : ''}`}
  data-slug={demo.id}
  data-status={d.status}
  data-condition={d.condition ?? 'unknown'}
  data-category={d.category ?? ''}
  data-topics={joinValues(d.topics)}
  data-courses={joinValues(d.course_tags)}
  data-time-buckets={joinValues(timeBuckets(d.demo_minutes))}
  data-rooms={joinValues(d.room_requirements)}
  data-hazards={joinValues(d.hazards)}
>
  {
    photo ? (
      <Image
        class="thumb"
        src={photo.src}
        alt={photo.alt}
        width={160}
        height={160}
        widths={[64, 128, 160, 320]}
        sizes="(max-width: 48rem) 64px, 160px"
      />
    ) : (
      <p class="no-photo">No photograph yet</p>
    )
  }
  {
    d.hazards.length > 0 && (
      <p class="hazard-badge" role="img" aria-label={`Hazard: ${hazardNames}`}>
        <span aria-hidden="true">▲</span>
        <span class="hazard-names" aria-hidden="true">
          {hazardNames}
        </span>
      </p>
    )
  }
  <div class="card-body">
    <h2><a href={`/demos/${demo.id}/`}>{d.title}</a></h2>
    {d.summary && <p class="summary">{d.summary}</p>}
    {!d.summary && d.status === 'stub' && <p class="stub-line">Stub record: not yet documented.</p>}
    {
      d.condition && d.condition !== 'good' && (
        <p class="chips">
          <Chip label={humanize(d.condition)} tone="alert" />
        </p>
      )
    }
    {classLine && <p class="class-line">{classLine}</p>}
    <p class="card-footer">
      <span>{locationText ?? 'location not recorded'}</span>
      {courses.length > 0 && <span>{courses.join(' · ')}</span>}
    </p>
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-columns: 160px 1fr;
    position: relative;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--paper);
    overflow: hidden;
  }

  /* The Image component renders the <img>, so its class is not scoped. */
  .card :global(.thumb),
  .no-photo {
    width: 160px;
    height: 160px;
    object-fit: cover;
    border-right: 1px solid var(--rule);
  }

  .no-photo {
    margin: 0;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--muted);
  }

  /* Bold on-accent text on the accent fill (asserted in
     tests/theme-contrast.test.ts). Browsers drop backgrounds in print by
     default, which would print it white on white, so the fill is forced. */
  .hazard-badge {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    margin: 0;
    display: flex;
    gap: 0.35em;
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
    font-size: 0.8rem;
    line-height: 1.3;
    white-space: nowrap;
  }

  .card-body {
    padding: 0.75rem 0.85rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  h2 {
    font-size: 1.05rem;
    margin: 0;
    line-height: 1.25;
  }

  /* Reserves room for the widest real badge, measured in the built site
     at 1280x800 on 2026-09-28: "▲ high voltage" is 108.9px wide and sits
     0.75rem (12px) in from the card edge, so it reaches 120.9px in; the
     body's own 0.85rem padding covers 13.6px of that. 7.5rem leaves about
     12px of air. Margin, not padding: the title's box itself stays clear
     of the badge. The reservation exists only when a badge does. */
  .has-hazard h2 {
    margin-right: 7.5rem;
  }

  /* Link affordance must not depend on hover (build-plan amendment 11):
     pointers that can hover get the quiet title with a hover underline;
     everything else reads the underline at rest. */
  h2 a {
    text-decoration: underline;
  }

  @media (hover: hover) {
    h2 a {
      text-decoration: none;
    }

    h2 a:hover {
      text-decoration: underline;
    }
  }

  .summary {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .stub-line {
    margin: 0;
    font-size: 0.88rem;
    font-style: italic;
    color: var(--muted);
  }

  .class-line {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .chips {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .card-footer {
    margin: 0;
    margin-top: auto;
    border-top: 1px solid var(--rule);
    padding-top: 0.5rem;
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  /* Compact: the same card shrunk. A 64px thumbnail beside the text; the
     column carries the thumbnail's left margin so the image never spills
     into the prose. No summary, no stub marker, and no photo panel: a
     photo-less card is a single text column. The hazard badge keeps only
     its icon, the names stay in the accessible label, and the orange left
     edge from amendment 13 returns. */
  @media (max-width: 48rem) {
    .card {
      grid-template-columns: calc(64px + 0.75rem) 1fr;
    }

    .card:has(.no-photo) {
      grid-template-columns: 1fr;
    }

    .card :global(.thumb) {
      width: 64px;
      height: 64px;
      margin: 0.75rem 0 0 0.75rem;
      border: 1px solid var(--rule);
    }

    .no-photo,
    .summary,
    .stub-line {
      display: none;
    }

    /* The names drop from sight only. The badge itself is never removed,
       and its accessible name comes from aria-label, not from this span
       (which is aria-hidden at every width), so hiding the span outright
       costs a screen reader nothing. A 1px clip box would still read as
       visible to layout and to the e2e gate. */
    .hazard-names {
      display: none;
    }

    .has-hazard {
      border-left: 3px solid var(--accent);
    }

    /* The icon-only badge measures 30.3px and reaches 42.3px in; the
       body padding covers 12.8px, so 2.25rem leaves about 6px of air. */
    .has-hazard h2 {
      margin-right: 2.25rem;
    }

    .card-body {
      padding: 0.7rem 0.8rem 0.75rem;
      gap: 0.4rem;
    }

    h2 {
      font-size: 1.1rem;
    }

    .class-line {
      font-size: 0.88rem;
    }

    /* The whole card is the tap target, not just the title. The stretched
       pseudo-element keeps one link in the accessibility tree, named by
       the title and nothing else. Text selection inside a card is the
       price, and a shelf letter is worth less than the tap. */
    h2 a::after {
      content: '';
      position: absolute;
      inset: 0;
    }
  }
</style>
