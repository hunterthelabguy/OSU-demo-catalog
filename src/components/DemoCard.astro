---
// The demo card, spec section 6's signature element, in its 2026-08-15
// design-pass form (build-plan amendment 12): photograph area with the
// status worn as a stamp, a hazard band that reads hotter than status,
// then title, classification line, and a mono logistics footer. Every
// facet value rides the card as data-* attributes; the index page script
// toggles visibility, so this component is the only source of card markup.
// `data-hazards` is not a facet (amendment 15) and rides for the compact
// stylesheet, which draws the accent edge off it.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Chip from './Chip.astro';
import { joinValues, sortCourses, timeBuckets } from '../lib/facets';
import { humanize } from '../lib/format';

interface Props {
  demo: CollectionEntry<'demos'>;
}
const { demo } = Astro.props;
const d = demo.data;
const photo = d.images[0];

// Topics carry the physics, tags carry the apparatus-speak; one muted line,
// topics first. Tags are searchable prose, never a facet (amendment 10).
const classLine = [
  d.topics.map(humanize).join(', '),
  d.tags.length > 0 ? d.tags.join(', ') : null,
]
  .filter(Boolean)
  .join(' · ');

// The footer answers "where is it, which course": location left, courses
// right. A record with neither gets no footer row rather than a row of
// unknowns; a record with courses but no shelf says so plainly.
const locationText = d.location
  ? [d.location.room, d.location.shelf].filter(Boolean).join(' · ')
  : null;
const courses = sortCourses(d.course_tags);
const hasFooter = locationText !== null || courses.length > 0;
---

<article
  class="card"
  data-slug={demo.id}
  data-status={d.status}
  data-condition={d.condition ?? 'unknown'}
  data-category={d.category ?? ''}
  data-topics={joinValues(d.topics)}
  data-courses={joinValues(d.course_tags)}
  data-time-buckets={joinValues(timeBuckets(d.demo_minutes))}
  data-rooms={joinValues(d.room_requirements)}
  data-hazards={joinValues(d.hazards)}
>
  <div class="photo">
    {
      photo ? (
        <Image src={photo.src} alt={photo.alt} widths={[400, 800]} sizes="(max-width: 40rem) 100vw, 20rem" />
      ) : (
        <p class="no-photo">No photograph yet</p>
      )
    }
    <span class={`stamp ${d.status === 'stub' ? 'stamp-stub' : ''}`}>{d.status}</span>
  </div>
  {
    d.hazards.length > 0 && (
      <p class="hazard-band">
        <span aria-hidden="true">▲</span>
        {d.hazards.length === 1 ? 'Hazard' : 'Hazards'}:{' '}
        {d.hazards.map(humanize).join(' · ')}
      </p>
    )
  }
  <div class="card-body">
    <h2><a href={`/demos/${demo.id}/`}>{d.title}</a></h2>
    <!-- The compact chip row carries what the photo stamp and the hazard
         band carry at full width, because neither survives below the
         compact breakpoint. Exactly one treatment is displayed at any
         width, so the accessibility tree only ever reaches one of them.
         Hazards lead and are never the chips that get truncated. -->
    <p class="chips">
      {
        d.hazards.map((hazard) => (
          <span class="compact-only">
            <Chip label={`▲ ${humanize(hazard)}`} tone="alert" />
          </span>
        ))
      }
      <span class="compact-only">
        <Chip label={d.status} tone={d.status === 'stub' ? 'stamp-muted' : 'stamp'} />
      </span>
      {
        d.condition && d.condition !== 'good' && (
          <span class="always">
            <Chip label={humanize(d.condition)} tone="alert" />
          </span>
        )
      }
      {
        d.room_requirements.map((requirement) => (
          <span class="compact-only">
            <Chip label={humanize(requirement)} tone="neutral" />
          </span>
        ))
      }
    </p>
    {classLine && <p class="class-line">{classLine}</p>}
    {
      hasFooter && (
        <p class="card-footer">
          <span>{locationText ?? 'location not recorded'}</span>
          {courses.length > 0 && <span>{courses.join(' · ')}</span>}
        </p>
      )
    }
  </div>
</article>

<style>
  .card {
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--panel);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .photo {
    position: relative;
    border-bottom: 1px solid var(--rule);
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    /* The placeholder stripes: two neutral tokens, no new hue. A real
       photograph covers them entirely. */
    background: repeating-linear-gradient(
      45deg,
      var(--panel-2) 0 7px,
      var(--surface) 7px 14px
    );
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .no-photo {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--muted);
  }

  /* The status stamp wears the accent only when the record has earned it:
     stubs stamp in muted, because a stub is not a claim. */
  .stamp {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.63rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--paper);
    background: var(--accent-text);
    padding: 0.2rem 0.4rem;
    border-radius: 2px;
  }

  .stamp-stub {
    background: var(--muted);
  }

  .hazard-band {
    margin: 0;
    border-top: 2px solid var(--accent);
    background: var(--accent-tint);
    padding: 0.35rem 0.8rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.69rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-text);
  }

  .card-body {
    padding: 0.75rem 0.85rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
  }

  h2 {
    font-size: 1.05rem;
    margin: 0;
    line-height: 1.25;
  }

  /* Link affordance must not depend on hover (build-plan amendment 11):
     pointers that can hover get the quiet title with a hover underline;
     everything else reads the underline at rest. */
  h2 a {
    text-decoration: underline;
  }

  @media (hover: hover) {
    h2 a {
      text-decoration: none;
    }

    h2 a:hover {
      text-decoration: underline;
    }
  }

  .class-line {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .chips {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  /* Above the compact breakpoint the row exists only for the condition
     chip; with nothing but compact-only children it collapses entirely
     rather than leaving a flex gap behind. */
  .compact-only {
    display: none;
  }

  .chips:not(:has(.always)) {
    display: none;
  }

  .card-footer {
    margin: 0;
    margin-top: auto;
    border-top: 1px solid var(--rule);
    padding-top: 0.5rem;
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  /* Compact: 54 striped placeholders down a phone is noise, so the photo
     area and the hazard band both go, and their information moves to the
     chip row and a left accent edge. The card becomes title-first and
     roughly 110px tall, which also makes the whole card a tap target
     several times over the 44px floor. */
  @media (max-width: 48rem) {
    .photo,
    .hazard-band {
      display: none;
    }

    .compact-only {
      display: inline;
    }

    .chips:not(:has(.always)) {
      display: flex;
    }

    .card:not([data-hazards='']) {
      border-left: 3px solid var(--accent);
    }

    .card-body {
      padding: 0.7rem 0.8rem 0.75rem;
      gap: 0.4rem;
    }

    h2 {
      font-size: 1.1rem;
    }

    .class-line {
      font-size: 0.88rem;
    }

    /* The whole card is the tap target, not just the title. The stretched
       pseudo-element keeps one link in the accessibility tree, named by
       the title and nothing else. Text selection inside a card is the
       price, and a shelf letter is worth less than the tap. */
    .card {
      position: relative;
    }

    h2 a::after {
      content: '';
      position: absolute;
      inset: 0;
    }
  }
</style>
