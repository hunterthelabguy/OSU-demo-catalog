---
// Base layout: global styles and site chrome. Fonts and every color token
// live in src/styles/theme.css, the single file a fork edits to rebrand.
//
// The masthead wears the official OSU horizontal mark (build-plan
// amendment 18) on the paper background: 'full' is the index lockup with
// the record counts, 'slim' is the one-line header every other page wears,
// with a print button that appears only once JavaScript wires it. Two
// pre-colored marks swap by color scheme; print always takes the light one.
import { Image } from 'astro:assets';
import '../styles/theme.css';
import markLight from '../assets/brand/osu-horizontal-2c-o-over-b.png';
import markDark from '../assets/brand/osu-horizontal-2c-o-over-w.png';

interface Props {
  title: string;
  description?: string;
  masthead?: 'full' | 'slim';
  /** Right-aligned mono annotation in the full masthead, e.g.
   *  "54 records · 12 documented". Computed by the page; the layout does
   *  not query content. */
  mastheadMeta?: string;
}
const { title, description, masthead = 'slim', mastheadMeta } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Permanent by amendment 22, never remove: the catalog is reached by
         link, never by search engine. public/robots.txt refuses crawlers
         too, but it is advisory; this tag is the per-page statement. -->
    <meta name="robots" content="noindex" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body>
    {
      masthead === 'full' ? (
        <header class="masthead masthead-full">
          <div class="masthead-inner">
            <p class="lockup">
              <Image src={markLight} alt="Oregon State University" height={48} class="mark logo-light" loading="eager" densities={[1, 2, 3]} format="png" />
              <Image src={markDark} alt="Oregon State University" height={48} class="mark logo-dark" loading="eager" densities={[1, 2, 3]} format="png" />
              <span class="site-title">Physics Demonstration Catalog</span>
            </p>
            {mastheadMeta && <p class="masthead-meta">{mastheadMeta}</p>}
          </div>
        </header>
      ) : (
        <header class="masthead masthead-slim">
          <div class="masthead-inner">
            <p class="lockup">
              <Image src={markLight} alt="Oregon State University" height={32} class="mark logo-light" loading="eager" densities={[1, 2, 3]} format="png" />
              <Image src={markDark} alt="Oregon State University" height={32} class="mark logo-dark" loading="eager" densities={[1, 2, 3]} format="png" />
              <a href="/" class="site-title">Physics Demonstration Catalog</a>
            </p>
            <button type="button" class="print-button" hidden>
              Print this record
            </button>
          </div>
        </header>
      )
    }
    <slot />
    <footer class="site-footer">
      <p>
        Content CC BY-SA 4.0, code MIT.
        <a href="https://github.com/hunterthelabguy/OSU-demo-catalog">Source</a>
      </p>
    </footer>
  </body>
</html>

<script>
  // The print button is chrome, not content: it exists only when the
  // script that makes it work is running.
  const printButton = document.querySelector<HTMLButtonElement>('.print-button');
  if (printButton) {
    printButton.hidden = false;
    printButton.addEventListener('click', () => window.print());
  }
</script>

<style is:global>
  * {
    box-sizing: border-box;
  }

  /* The hidden attribute must always win. Without this, any component that
     sets its own display (the demo card is display: grid) silently defeats
     hidden, because author styles outrank the UA's [hidden] rule. */
  [hidden] {
    display: none !important;
  }

  html {
    background: var(--paper);
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* The masthead sits on paper and carries the official mark, not a fill.
     The mark files are pre-colored for each scheme; display swaps them.
     Print comes last so it wins: a dark-scheme browser still prints the
     light mark. */
  .masthead {
    background: var(--paper);
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
  }

  .masthead-inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: 0.8rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .masthead .lockup {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .mark {
    width: auto;
    display: block;
  }

  .logo-dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    .logo-light {
      display: none;
    }
    .logo-dark {
      display: block;
    }
  }

  @media print {
    .logo-light {
      display: block;
    }
    .logo-dark {
      display: none;
    }
  }

  .masthead .site-title {
    border-left: 1px solid var(--rule);
    padding-left: 1rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .masthead-slim .site-title {
    font-size: 0.95rem;
    text-decoration: none;
  }

  .masthead-slim a.site-title:hover,
  .masthead-slim a.site-title:focus-visible {
    text-decoration: underline;
  }

  .masthead-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.72rem;
  }

  .masthead-slim .masthead-inner {
    padding: 0.65rem 1.25rem;
  }

  .print-button {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.72rem;
    color: var(--ink);
    background: none;
    border: 1px solid var(--ink);
    border-radius: 2px;
    padding: 0.3rem 0.6rem;
    cursor: pointer;
  }

  main {
    flex: 1;
    width: 100%;
    max-width: 46rem;
    margin-inline: auto;
    padding: 1.5rem 1.25rem 4rem;
  }

  main.wide {
    max-width: 72rem;
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    padding: 0.75rem 1.25rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .site-footer p {
    margin: 0;
  }

  /* Compact: the header keeps the mark and the counts but stops spending
     a phone's vertical budget on them. Every pixel here is one the first
     result does not have to scroll past. */
  @media (max-width: 48rem) {
    .masthead-inner {
      padding: 0.5rem 1rem;
      gap: 0.35rem;
    }

    .masthead-full .mark {
      height: 32px;
    }

    .masthead-full .site-title {
      font-size: 1.05rem;
    }

    .masthead .lockup {
      gap: 0.75rem;
    }

    .masthead .site-title {
      padding-left: 0.75rem;
    }

    .masthead-meta {
      font-size: 0.68rem;
    }

    .masthead-slim .masthead-inner {
      padding: 0.5rem 1rem;
    }

    /* The one interactive control in the header answers to the same 44px
       floor as every control in the facet panel. */
    .print-button {
      min-height: 2.75rem;
      padding-inline: 0.85rem;
    }

    main {
      padding: 1rem 1rem 3rem;
    }
  }

  @media print {
    /* Print tokens are forced light in theme.css. The printed record keeps
       the official mark; the button and the counts are screen chrome. */
    .print-button,
    .masthead-meta,
    .site-footer {
      display: none;
    }
    .masthead-inner {
      padding-inline: 0;
    }
    body {
      font-size: 10.5pt;
    }
    main {
      max-width: none;
      padding: 0;
    }
    @page {
      margin: 15mm;
    }
  }
</style>
