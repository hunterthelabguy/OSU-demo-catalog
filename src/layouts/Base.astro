---
// Base layout: global styles and site chrome. Fonts and every color token
// live in src/styles/theme.css, the single file a fork edits to rebrand.
//
// The masthead is the accent band from the 2026-08-15 design pass
// (build-plan amendment 12): 'full' is the index lockup with the record
// counts, 'slim' is the one-line band every other page wears, with a
// print button that appears only once JavaScript wires it.
import '../styles/theme.css';

interface Props {
  title: string;
  description?: string;
  masthead?: 'full' | 'slim';
  /** Right-aligned mono annotation in the full masthead, e.g.
   *  "54 records · 12 documented". Computed by the page; the layout does
   *  not query content. */
  mastheadMeta?: string;
}
const { title, description, masthead = 'slim', mastheadMeta } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Remove at launch. Spec section 9 keeps the URL inside the faculty
         preview until infrastructure is final; noindex keeps search engines
         from circulating it first. -->
    <meta name="robots" content="noindex" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body>
    {
      masthead === 'full' ? (
        <header class="masthead masthead-full">
          <div class="masthead-inner">
            <p class="lockup">
              <span class="kicker">Oregon State University · Department of Physics</span>
              <span class="site-title">Physics Demonstration Catalog</span>
            </p>
            {mastheadMeta && <p class="masthead-meta">{mastheadMeta}</p>}
          </div>
        </header>
      ) : (
        <header class="masthead masthead-slim">
          <div class="masthead-inner">
            <p class="lockup">
              <a href="/">Physics Demonstration Catalog</a>
              <span class="kicker-inline"> · Oregon State University</span>
            </p>
            <button type="button" class="print-button" hidden>
              Print this record
            </button>
          </div>
        </header>
      )
    }
    <slot />
    <footer class="site-footer">
      <p>
        Content CC BY-SA 4.0, code MIT.
        <a href="https://github.com/hunterthelabguy/OSU-demo-catalog">Source</a>
      </p>
    </footer>
  </body>
</html>

<script>
  // The print button is chrome, not content: it exists only when the
  // script that makes it work is running.
  const printButton = document.querySelector<HTMLButtonElement>('.print-button');
  if (printButton) {
    printButton.hidden = false;
    printButton.addEventListener('click', () => window.print());
  }
</script>

<style is:global>
  * {
    box-sizing: border-box;
  }

  /* The hidden attribute must always win. Without this, any component that
     sets its own display (the demo card is display: flex) silently defeats
     hidden, because author styles outrank the UA's [hidden] rule. */
  [hidden] {
    display: none !important;
  }

  html {
    background: var(--paper);
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  :focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* The accent band. --accent is a fill here, never text: everything on
     the band is --on-accent, asserted AA by the contrast test. Focus rings
     inside the band switch to --on-accent because the accent-colored ring
     vanishes against its own fill. */
  .masthead {
    background: var(--accent);
    color: var(--on-accent);
  }

  .masthead :focus-visible {
    outline-color: var(--on-accent);
  }

  .masthead-inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: 0.8rem 1.25rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .masthead .lockup {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }

  .masthead-full .kicker {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .masthead-full .site-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .masthead-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.72rem;
  }

  .masthead-slim .masthead-inner {
    padding: 0.65rem 1.25rem;
    align-items: center;
  }

  .masthead-slim .lockup {
    flex-direction: row;
    align-items: baseline;
    gap: 0;
    font-size: 0.82rem;
  }

  .masthead-slim a {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .masthead-slim a:hover,
  .masthead-slim a:focus-visible {
    text-decoration: underline;
  }

  .masthead-slim .kicker-inline {
    font-weight: 400;
    opacity: 0.85;
    white-space: pre;
  }

  .print-button {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.72rem;
    color: var(--on-accent);
    background: none;
    border: 1px solid var(--on-accent);
    border-radius: 2px;
    padding: 0.3rem 0.6rem;
    cursor: pointer;
  }

  main {
    flex: 1;
    width: 100%;
    max-width: 46rem;
    margin-inline: auto;
    padding: 1.5rem 1.25rem 4rem;
  }

  main.wide {
    max-width: 72rem;
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    padding: 0.75rem 1.25rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .site-footer p {
    margin: 0;
  }

  @media print {
    /* Print tokens are forced light in theme.css. */
    .masthead,
    .site-footer {
      display: none;
    }
    body {
      font-size: 10.5pt;
    }
    main {
      max-width: none;
      padding: 0;
    }
    @page {
      margin: 15mm;
    }
  }
</style>
