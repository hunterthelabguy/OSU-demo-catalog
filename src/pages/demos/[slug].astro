---
// One page per demonstration, in its 2026-08-15 design-pass form
// (build-plan amendment 12): predict-first and hazard-forward. The hazard
// band and the prediction callout lead; the boxed strip answers "can I
// run this Tuesday" before the prose. This template stays glue:
// formatting lives in src/lib/format.ts, validation in the schema.
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Chip from '../../components/Chip.astro';
// KaTeX styles load here, not in theme.css: only demo pages can render
// math, and the index has no business paying for the stylesheet
// (build-plan amendment 11).
import 'katex/dist/katex.min.css';
import { REQUEST_URL_TEMPLATE } from '../../config';
import { formatDate, formatMinutes, formatMinutesRange, humanize } from '../../lib/format';

export async function getStaticPaths() {
  const demos = await getCollection('demos');
  return demos.map((demo) => ({ params: { slug: demo.id }, props: { demo } }));
}

interface Props {
  demo: CollectionEntry<'demos'>;
}
const { demo } = Astro.props;
const d = demo.data;
const { Content } = await render(demo);

const hasBody = (demo.body ?? '').trim().length > 0;
const isStub = d.status === 'stub';

// The strip renders only rows whose fields exist: a sparse record gets a
// sparse label, not a label full of blanks (spec section 6, stub rendering).
// Hazards moved out of the strip into the band above the fold.
const hasLogistics =
  d.pira_dcs != null ||
  d.demo_minutes !== undefined ||
  d.setup_minutes !== undefined ||
  d.teardown_minutes !== undefined ||
  d.setup_difficulty !== undefined ||
  d.transportable !== undefined ||
  d.quantity !== undefined ||
  d.location !== undefined ||
  d.room_requirements.length > 0 ||
  d.consumables.length > 0 ||
  d.accessibility !== undefined;

const requestUrl = REQUEST_URL_TEMPLATE?.replace('{slug}', d.slug) ?? null;
const printUrl = Astro.site ? new URL(`/demos/${demo.id}/`, Astro.site).href : null;

// Tags ride the classification line so they are visible prose inside the
// Pagefind-indexed body: searchable, never a facet.
const classificationLine = [
  d.topics.map(humanize).join(', '),
  d.tags.length > 0 ? `tags: ${d.tags.join(', ')}` : null,
  d.course_tags.length > 0 ? d.course_tags.join(', ') : null,
  d.typical_units.length > 0 ? `units: ${d.typical_units.join(', ')}` : null,
]
  .filter(Boolean)
  .join(' · ');

const hasPrep = d.setup_minutes !== undefined || d.teardown_minutes !== undefined;
const prepLine = [
  d.setup_minutes !== undefined ? `setup ${formatMinutes(d.setup_minutes)}` : null,
  d.teardown_minutes !== undefined ? `teardown ${formatMinutes(d.teardown_minutes)}` : null,
]
  .filter(Boolean)
  .join(', ');
---

<Base title={`${d.title} · Physics Demonstration Catalog`} description={d.topics.join(', ')}>
  <main>
    <!-- data-pagefind-body scopes the search index to demo pages only: the
         index page and any future about page stay out of search results. -->
    <article data-pagefind-body>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Catalog</a>
        {d.category && <> / {humanize(d.category)}</>}
        {d.topics.length > 0 && <> / {d.topics.map(humanize).join(', ')}</>}
      </nav>

      <header class="demo-header">
        <div class="title-row">
          <h1>{d.title}</h1>
          <Chip label={d.status} tone={isStub ? 'stamp-muted' : 'stamp'} />
          {
            d.condition && d.condition !== 'good' && (
              <Chip label={humanize(d.condition)} tone="alert" />
            )
          }
          {d.condition === 'good' && <Chip label="condition: good" tone="neutral" />}
        </div>
        <p class="classification">{classificationLine}</p>
      </header>

      {
        d.hazards.length > 0 && (
          <p class="hazard-band">
            <span aria-hidden="true">▲</span>
            <span class="hazard-label">
              {d.hazards.length === 1 ? 'Hazard' : 'Hazards'} ·{' '}
              {d.hazards.map(humanize).join(' · ')}
            </span>
          </p>
        )
      }

      {
        isStub && (
          <section class="stub-band" aria-label="Documentation status">
            <p>
              <strong>Not yet documented.</strong> This record is a stub. What
              appears on this page is everything the catalog knows so far.
            </p>
          </section>
        )
      }

      {
        (d.prediction_prompt || d.target_misconceptions.length > 0) && (
          <section class="prediction">
            <h2>Predict first · ask before you run it</h2>
            {d.prediction_prompt && <p class="prompt">{d.prediction_prompt}</p>}
            {d.target_misconceptions.length > 0 && (
              <>
                <p class="misconceptions-label">Targets these misconceptions</p>
                <ul>
                  {d.target_misconceptions.map((m) => (
                    <li>{m}</li>
                  ))}
                </ul>
              </>
            )}
          </section>
        )
      }

      {
        hasLogistics && (
          <section class="strip" aria-labelledby="strip-title">
            <p class="strip-title" id="strip-title">Can I run this Tuesday</p>
            <dl>
              {d.demo_minutes !== undefined && (
                <div class="cell">
                  <dt>Demo time</dt>
                  <dd>{formatMinutesRange(d.demo_minutes)}</dd>
                </div>
              )}
              {d.pira_dcs != null && (
                <div class="cell">
                  <dt>PIRA</dt>
                  <dd>
                    <code>{d.pira_dcs}</code>
                    {!d.pira_verified && <span class="unverified"> (unverified)</span>}
                  </dd>
                </div>
              )}
              {hasPrep && (
                <div class="cell">
                  <dt>Prep</dt>
                  <dd>{prepLine}</dd>
                </div>
              )}
              {d.setup_difficulty && (
                <div class="cell">
                  <dt>Setup difficulty</dt>
                  <dd class="difficulty">{d.setup_difficulty}</dd>
                </div>
              )}
              {d.quantity !== undefined && (
                <div class="cell">
                  <dt>Quantity</dt>
                  <dd>{d.quantity}</dd>
                </div>
              )}
              {d.transportable !== undefined && (
                <div class="cell">
                  <dt>Transportable</dt>
                  <dd>{d.transportable ? 'yes' : 'no, fixed room'}</dd>
                </div>
              )}
              {d.location && (
                <div class="cell">
                  <dt>Location</dt>
                  <dd>
                    <code>
                      {[d.location.room, d.location.shelf].filter(Boolean).join(' · ')}
                    </code>
                  </dd>
                </div>
              )}
              {d.room_requirements.length > 0 && (
                <div class="cell wide">
                  <dt>Room needs</dt>
                  <dd class="chip-row">
                    {d.room_requirements.map((requirement) => (
                      <Chip label={humanize(requirement)} tone="neutral" />
                    ))}
                  </dd>
                </div>
              )}
              {d.consumables.length > 0 && (
                <div class="cell wide">
                  <dt>Consumables</dt>
                  <dd>{d.consumables.join('; ')}</dd>
                </div>
              )}
              {d.accessibility && (
                <div class="cell wide">
                  <dt>Accessibility</dt>
                  <dd class="chip-row">
                    {d.accessibility.hearing && (
                      <Chip
                        label={`hearing: ${humanize(d.accessibility.hearing)}`}
                        tone={d.accessibility.hearing === 'inaccessible' ? 'alert' : 'neutral'}
                      />
                    )}
                    {d.accessibility.vision && (
                      <Chip
                        label={`vision: ${humanize(d.accessibility.vision)}`}
                        tone={d.accessibility.vision === 'inaccessible' ? 'alert' : 'neutral'}
                      />
                    )}
                    {d.accessibility.notes && (
                      <span class="access-notes">{d.accessibility.notes}</span>
                    )}
                  </dd>
                </div>
              )}
            </dl>
          </section>
        )
      }

      {
        hasPrep && (
          <p class="prep-note">
            Setup and teardown are handled with stockroom support. Choose by
            demonstration time, not prep time.
          </p>
        )
      }

      {
        d.images.length > 0 ? (
          <section class="photos">
            {d.images.map((img) => (
              <figure>
                <Image src={img.src} alt={img.alt} widths={[480, 960]} sizes="(max-width: 46rem) 100vw, 46rem" />
                {img.caption && <figcaption>{img.caption}</figcaption>}
              </figure>
            ))}
          </section>
        ) : (
          !isStub && (
            <p class="photo-placeholder">
              <span>No photograph yet</span>
            </p>
          )
        )
      }

      {
        hasBody && (
          <div class="body">
            <Content />
          </div>
        )
      }

      {
        d.maintenance_log.length > 0 && (
          <section class="maintenance">
            <h2>Maintenance log</h2>
            <ul>
              {d.maintenance_log.map((entry) => (
                <li>
                  <code>{formatDate(entry.date)}</code> {entry.note}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        d.notes && (
          <section class="curator-notes">
            <h2>Curator notes</h2>
            <p>{d.notes}</p>
          </section>
        )
      }

      {requestUrl && <a class="request" href={requestUrl}>Request this demo</a>}

      <footer class="provenance">
        <p>
          <code>{d.slug}</code>
          {d.last_updated && <> · record updated {formatDate(d.last_updated)}</>}
          {
            d.last_verified ? (
              <> · apparatus checked {formatDate(d.last_verified)}</>
            ) : (
              <> · apparatus not yet checked</>
            )
          }
        </p>
        {printUrl && <p class="print-url">{printUrl}</p>}
      </footer>
    </article>
  </main>
</Base>

<style>
  .breadcrumb {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .breadcrumb a {
    color: var(--ink);
  }

  .title-row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
  }

  .demo-header h1 {
    font-size: 2.15rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
  }

  .classification {
    margin: 0 0 1.25rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* Hazard-forward: the band outranks every chip. Accent fill, bold
     on-accent text; hotter than the status stamp by design. The fill is
     forced in print: browsers drop backgrounds by default, which would
     print the white text on white. */
  .hazard-band {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
    margin: 0 0 1.4rem;
    border: 2px solid var(--accent);
    background: var(--accent);
    border-radius: 2px;
    padding: 0.65rem 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--on-accent);
    font-weight: 700;
  }

  .hazard-band .hazard-label {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
  }

  .stub-band {
    border: 2px dashed var(--muted);
    border-radius: 2px;
    padding: 0.8rem 1rem;
    margin-bottom: 1.5rem;
  }

  .stub-band p {
    margin: 0;
    color: var(--muted);
  }

  /* The prediction callout leads the page because predict-first is the
     half of a demonstration that produces learning (spec, Pedagogical
     grounding). */
  .prediction {
    border: 1px solid var(--rule);
    border-left: 4px solid var(--accent);
    border-radius: 2px;
    background: var(--paper);
    padding: 1rem 1.2rem 1.2rem;
    margin: 0 0 1.4rem;
  }

  .prediction h2 {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--ink);
  }

  .prediction .prompt {
    font-size: 1.3rem;
    line-height: 1.4;
    text-wrap: pretty;
    margin: 0 0 0.9rem;
  }

  .misconceptions-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.69rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--muted);
    margin: 0 0 0.3rem;
  }

  .prediction ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .prediction li {
    margin-bottom: 0.3rem;
  }

  /* The specimen label, boxed with its own header bar. Dense, hairline
     divided: answers "can I actually run this Tuesday" before the prose. */
  .strip {
    border: 1px solid var(--rule);
    border-radius: 2px;
    margin-bottom: 0.8rem;
    overflow: hidden;
  }

  .strip-title {
    margin: 0;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    padding: 0.4rem 0.7rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.69rem;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--muted);
  }

  .strip dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
  }

  .cell {
    padding: 0.55rem 0.7rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .cell.wide {
    grid-column: 1 / -1;
  }

  .strip dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.63rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--muted);
    margin-bottom: 0.15rem;
  }

  .strip dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.88rem;
  }

  .strip .difficulty {
    color: var(--ink);
  }

  .strip .unverified {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .prep-note {
    margin: 0 0 1.5rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .access-notes {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--muted);
    flex-basis: 100%;
  }

  .photos figure {
    margin: 0 0 1rem;
  }

  .photos img {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }

  .photos figcaption {
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 0.35rem;
  }

  /* A flat paper ground stands where the apparatus photograph belongs,
     same placeholder the cards wear. Stubs skip it: the stub band has already
     said the record is thin. */
  .photo-placeholder {
    margin: 0 0 1.5rem;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--paper);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .photo-placeholder span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  /* Body sections: catalog-style rules above each heading. */
  .body :global(h2) {
    font-size: 1.2rem;
    border-top: 1px solid var(--rule);
    padding-top: 0.9rem;
    margin: 1.75rem 0 0.6rem;
  }

  .body :global(ol),
  .body :global(ul) {
    padding-left: 1.3rem;
  }

  /* KaTeX ships display math as a plain block with no overflow rule, so a
     wide equation runs off a narrow viewport instead of scrolling. The
     padding keeps a scrollbar from sitting on the glyphs. */
  .body :global(.katex-display) {
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: 0.35rem;
  }

  .maintenance h2,
  .curator-notes h2 {
    font-size: 1.05rem;
    border-top: 1px solid var(--rule);
    padding-top: 0.9rem;
    margin: 1.75rem 0 0.5rem;
  }

  .maintenance ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.95rem;
  }

  .maintenance li {
    margin-bottom: 0.3rem;
  }

  .curator-notes p {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .request {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.55rem 1rem;
    border: 2px solid var(--ink);
    border-radius: 2px;
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
  }

  .provenance {
    margin-top: 2.5rem;
    border-top: 1px solid var(--rule);
    padding-top: 0.6rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .provenance p {
    margin: 0;
  }

  .print-url {
    display: none;
  }

  /* Compact: the auto-fit strip becomes label/value rows. At 375px it
     otherwise gives two columns of roughly 167px, and a 0.63rem uppercase
     label with 0.11em tracking is past legible in a cell that narrow.
     40rem rather than the index's 48rem: this is the width where the
     auto-fit cells themselves stop working, which is a different question
     from where a sidebar stops fitting (amendment 13). */
  @media (max-width: 40rem) {
    .strip dl {
      display: block;
    }

    .cell {
      display: flex;
      gap: 0.75rem;
      border-right: none;
    }

    .cell dt {
      width: 6rem;
      flex: none;
      margin-bottom: 0;
      padding-top: 0.2rem;
    }

    /* Chip rows need the whole width, so their label goes back on top. */
    .cell.wide {
      display: block;
    }

    .cell.wide dt {
      width: auto;
      margin-bottom: 0.35rem;
      padding-top: 0;
    }

    .demo-header h1 {
      font-size: 1.75rem;
    }

    .prediction {
      padding: 0.85rem 0.9rem 1rem;
    }

    .prediction .prompt {
      font-size: 1.125rem;
    }

    .breadcrumb {
      margin-bottom: 0.75rem;
    }
  }

  @media print {
    .request {
      display: none;
    }
    .strip,
    .prediction,
    .stub-band,
    .hazard-band {
      break-inside: avoid;
    }
    .strip {
      border-color: #000;
    }
    .photo-placeholder {
      display: none;
    }
    .print-url {
      display: block;
      margin-top: 0.3rem;
    }
    .demo-header h1 {
      font-size: 18pt;
      margin-top: 0;
    }
    .breadcrumb {
      display: none;
    }
  }
</style>
