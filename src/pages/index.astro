---
// The catalog index: every card baked into the HTML at build time, facets
// as show/hide over data-* attributes, Pagefind as the URL-set oracle for
// free text (build-plan amendment 3). With JavaScript off, the full grid
// renders with live links and the filter form is inert.
//
// Layout is the 2026-08-15 design pass (amendment 12): masthead lockup,
// full-width search band, facet sidebar, results column with removable
// filter chips. Facet counts are baked at build time and count every
// record carrying the value, stubs included: the sidebar describes the
// stockroom, not the current view.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import DemoCard from '../components/DemoCard.astro';
import { TIME_BUCKETS, deriveFacets, subtopicsByCategory, timeBuckets } from '../lib/facets';
import { humanize } from '../lib/format';

const demos = (await getCollection('demos')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const facets = deriveFacets(demos);
const documented = demos.filter((d) => d.data.status !== 'stub').length;
const stubCount = demos.length - documented;
const oosCount = demos.filter((d) => d.data.condition === 'out_of_service').length;

// The two-level topic browse: category blocks with disclosure-revealed
// subtopic checkboxes, comPADRE / Physics and Equity style (build-plan
// amendment 10). Categories with nothing to show are dropped inside
// subtopicsByCategory.
const categoryGroups = subtopicsByCategory(demos).map((group) => ({
  ...group,
  count: demos.filter((d) => d.data.category === group.category).length,
}));

// Demonstration-time options render only for buckets some record actually
// overlaps, so a rendered checkbox can never match nothing; with no timed
// records, the whole group vanishes via the options.length filter below.
const usedTimeBuckets = new Set(demos.flatMap((d) => timeBuckets(d.data.demo_minutes)));

const groups: {
  param: string;
  legend: string;
  options: { value: string; label: string; count: number }[];
}[] = [
  {
    param: 'time',
    legend: 'Demo time',
    options: TIME_BUCKETS.filter((b) => usedTimeBuckets.has(b.value)).map((b) => ({
      value: b.value,
      label: b.label,
      count: demos.filter((d) => timeBuckets(d.data.demo_minutes).includes(b.value)).length,
    })),
  },
  {
    param: 'room',
    legend: 'Room needs',
    options: facets.rooms.map((r) => ({
      value: r,
      label: humanize(r),
      count: demos.filter((d) => (d.data.room_requirements as readonly string[]).includes(r))
        .length,
    })),
  },
  {
    param: 'hazard',
    legend: 'Hazards',
    options: facets.hazards.map((h) => ({
      value: h,
      label: humanize(h),
      count: demos.filter((d) => (d.data.hazards as readonly string[]).includes(h)).length,
    })),
  },
].filter((group) => group.options.length > 0);
---

<Base
  title="Physics Demonstration Catalog"
  description="A browsable catalog of physics lecture demonstrations."
  masthead="full"
  mastheadMeta={`${demos.length} records · ${documented} documented`}
>
  <div class="search-band">
    <div class="search-inner">
      <label class="vh" for="q">Search</label>
      <input
        type="search"
        id="q"
        name="q"
        form="filters"
        placeholder="Search titles, topics, apparatus, procedure text"
        autocomplete="off"
      />
      <span class="search-note" id="search-note" hidden>
        Search needs the built site; run npm run preview. Filters still work.
      </span>
    </div>
  </div>

  <main class="wide shell">
    <form id="filters" class="sidebar" aria-label="Filter">
      <fieldset class="toggles">
        <legend><span class="legend-inner">Records</span></legend>
        <label>
          <input type="checkbox" name="stubs" value="1" />
          show stubs
          <span class="count">{stubCount}</span>
        </label>
        <label>
          <input type="checkbox" name="oos" value="1" />
          show out of service
          <span class="count">{oosCount}</span>
        </label>
      </fieldset>

      <!-- Two-level topic browse. The category checkbox sits BESIDE the
           details element, never inside its summary: a checkbox inside a
           summary is announced as part of a disclosure button and label
           clicks toggle both controls. Category and topic are independent
           facet groups; there is no tri-state parent logic. -->
      <fieldset class="topic-facet">
        <legend><span class="legend-inner">Topic</span></legend>
        {
          categoryGroups.map(({ category, subtopics, count }) => (
            <div class="cat-block">
              <label class="cat-label">
                <input type="checkbox" name="cat" value={category} />
                {humanize(category)}
                <span class="count">{count > 0 ? count : '·'}</span>
              </label>
              {subtopics.length > 0 && (
                <details class="cat-topics" data-category={category}>
                  <summary>
                    <span class="vh">{humanize(category)}: </span>
                    {subtopics.length} {subtopics.length === 1 ? 'topic' : 'topics'}
                  </summary>
                  <div class="topic-list">
                    {subtopics.map((subtopic) => (
                      <label>
                        <input type="checkbox" name="topic" value={subtopic} />
                        {humanize(subtopic)}
                      </label>
                    ))}
                  </div>
                </details>
              )}
            </div>
          ))
        }
      </fieldset>

      <fieldset class="course-facet">
        <legend><span class="legend-inner">Course</span></legend>
        <div class="course-chips">
          {
            facets.courses.map((course) => (
              <label class="course-chip">
                <input type="checkbox" name="course" value={course} />
                <span>{course}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      {
        groups.map((group) => (
          <fieldset data-param={group.param}>
            <legend>
              <span class="legend-inner">{group.legend}</span>
            </legend>
            {group.options.map((option) => (
              <label>
                <input type="checkbox" name={group.param} value={option.value} />
                {option.label}
                <span class="count">{option.count > 0 ? option.count : '·'}</span>
              </label>
            ))}
          </fieldset>
        ))
      }
    </form>

    <section class="results" aria-label="Results">
      <div class="results-head">
        <p id="count" aria-live="polite">{demos.length} demonstrations.</p>
        <ul id="active-chips" class="active-chips" hidden></ul>
        <button type="button" id="clear-all" class="linklike" hidden>Clear all</button>
      </div>

      <div class="grid" id="grid">
        {demos.map((demo) => <DemoCard demo={demo} />)}
      </div>

      <p id="stub-note" class="stub-note" hidden>
        <span id="stub-note-text"></span>
        <button type="button" id="include-stubs" class="linklike">Include stubs</button>
      </p>

      <div id="empty" class="empty" hidden>
        <p id="empty-message">No demonstrations match.</p>
      </div>
    </section>
  </main>
</Base>

<script>
  import { TIME_BUCKETS, splitValues } from '../lib/facets';
  import { humanize } from '../lib/format';
  import type { ActiveSelection, CardFacets, FilterState } from '../lib/filter-logic';
  import {
    activeSelections,
    cardVisible,
    hiddenStubNote,
    isDefaultHidden,
    matchesFacets,
    parseState,
    serializeState,
  } from '../lib/filter-logic';

  const form = document.getElementById('filters') as HTMLFormElement;
  const searchInput = document.getElementById('q') as HTMLInputElement;
  const searchNote = document.getElementById('search-note') as HTMLElement;
  const countEl = document.getElementById('count') as HTMLElement;
  const chipsEl = document.getElementById('active-chips') as HTMLElement;
  const clearAllButton = document.getElementById('clear-all') as HTMLButtonElement;
  const stubNoteEl = document.getElementById('stub-note') as HTMLElement;
  const stubNoteText = document.getElementById('stub-note-text') as HTMLElement;
  const includeStubsButton = document.getElementById('include-stubs') as HTMLButtonElement;
  const emptyEl = document.getElementById('empty') as HTMLElement;
  const emptyMessage = document.getElementById('empty-message') as HTMLElement;

  const cardEls = [...document.querySelectorAll<HTMLElement>('.card')];
  const cards: { el: HTMLElement; title: string; facets: CardFacets }[] = cardEls.map((el) => ({
    el,
    title: el.querySelector('h2')?.textContent?.trim() ?? (el.dataset.slug ?? ''),
    facets: {
      slug: el.dataset.slug ?? '',
      status: el.dataset.status ?? '',
      condition: el.dataset.condition ?? 'unknown',
      categories: el.dataset.category ? [el.dataset.category] : [],
      topics: splitValues(el.dataset.topics ?? ''),
      courses: splitValues(el.dataset.courses ?? ''),
      timeBuckets: splitValues(el.dataset.timeBuckets ?? ''),
      rooms: splitValues(el.dataset.rooms ?? ''),
      hazards: splitValues(el.dataset.hazards ?? ''),
    },
  }));

  // Pagefind loads lazily on first search. Under `astro dev` the bundle does
  // not exist; search degrades with a visible note and facets keep working.
  type Pagefind = {
    search: (q: string) => Promise<{ results: { data: () => Promise<{ url: string }> }[] }>;
  };
  let pagefind: Pagefind | null | 'failed' = null;
  let searchSlugs: ReadonlySet<string> | null = null;
  let lastChangedLabel = '';

  const loadPagefind = async (): Promise<Pagefind | null> => {
    if (pagefind === 'failed') return null;
    if (pagefind) return pagefind;
    try {
      // The bundle exists only after `pagefind --site dist`; the specifier
      // lives in a variable so neither vite nor TypeScript tries to resolve
      // a module that is not on disk at build time.
      const bundlePath = '/pagefind/pagefind.js';
      pagefind = (await import(/* @vite-ignore */ bundlePath)) as Pagefind;
      return pagefind;
    } catch {
      pagefind = 'failed';
      searchInput.setAttribute('aria-describedby', 'search-note');
      searchNote.hidden = false;
      return null;
    }
  };

  const runSearch = async (q: string): Promise<void> => {
    if (q.trim() === '') {
      searchSlugs = null;
      return;
    }
    const pf = await loadPagefind();
    if (!pf) {
      searchSlugs = null;
      return;
    }
    const { results } = await pf.search(q);
    const data = await Promise.all(results.map((r) => r.data()));
    searchSlugs = new Set(
      data
        .map((d) => /\/demos\/([^/]+)\/?$/.exec(d.url)?.[1])
        .filter((slug): slug is string => slug !== undefined),
    );
  };

  const readState = (): FilterState => {
    const fd = new FormData(form);
    // Set-dedupe is cheap insurance: each subtopic renders once under its
    // home category today, but a duplicated checkbox would otherwise
    // double-count in the URL and the filter count.
    return {
      q: searchInput.value,
      categories: [...new Set(fd.getAll('cat').map(String))],
      topics: [...new Set(fd.getAll('topic').map(String))],
      courses: fd.getAll('course').map(String),
      times: fd.getAll('time').map(String),
      rooms: fd.getAll('room').map(String),
      hazards: fd.getAll('hazard').map(String),
      showStubs: fd.get('stubs') === '1',
      showOutOfService: fd.get('oos') === '1',
    };
  };

  const writeControls = (state: FilterState): void => {
    searchInput.value = state.q;
    const selected: Record<string, string[]> = {
      cat: state.categories,
      topic: state.topics,
      course: state.courses,
      time: state.times,
      room: state.rooms,
      hazard: state.hazards,
      stubs: state.showStubs ? ['1'] : [],
      oos: state.showOutOfService ? ['1'] : [],
    };
    for (const input of form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')) {
      input.checked = (selected[input.name] ?? []).includes(input.value);
    }
    // A restored URL must show its own filters: open (never close) any
    // category disclosure whose block holds a checked box.
    for (const details of form.querySelectorAll<HTMLDetailsElement>('details[data-category]')) {
      const block = details.closest('.cat-block');
      if (block?.querySelector('input:checked')) details.open = true;
    }
  };

  const activeFilterCount = (state: FilterState): number =>
    state.categories.length +
    state.topics.length +
    state.courses.length +
    state.times.length +
    state.rooms.length +
    state.hazards.length +
    (state.q.trim() === '' ? 0 : 1);

  // Chip labels resolve the same way the sidebar renders them: humanized
  // vocabulary tokens, raw course codes, spec bucket labels for time.
  const timeLabels = new Map<string, string>(TIME_BUCKETS.map((b) => [b.value, b.label]));
  const chipLabel = ({ param, value }: ActiveSelection): string =>
    param === 'course' ? value : param === 'time' ? (timeLabels.get(value) ?? value) : humanize(value);

  const renderChips = (state: FilterState): void => {
    const selections = activeSelections(state);
    chipsEl.replaceChildren(
      ...selections.map((selection) => {
        const label = chipLabel(selection);
        const item = document.createElement('li');
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'active-chip';
        button.dataset.param = selection.param;
        button.dataset.value = selection.value;
        button.setAttribute('aria-label', `Remove filter: ${label}`);
        button.append(label);
        const x = document.createElement('span');
        x.setAttribute('aria-hidden', 'true');
        x.className = 'x';
        x.textContent = '×';
        button.append(x);
        item.append(button);
        return item;
      }),
    );
    chipsEl.hidden = selections.length === 0;
    clearAllButton.hidden = selections.length === 0;
  };

  const apply = (state: FilterState): void => {
    let visible = 0;
    let hiddenByDefault = 0;
    const hiddenStubTitles: string[] = [];
    for (const { el, title, facets } of cards) {
      const show = cardVisible(facets, state, searchSlugs);
      el.hidden = !show;
      if (show) visible += 1;
      else if (matchesFacets(facets, state, searchSlugs) && isDefaultHidden(facets, state)) {
        hiddenByDefault += 1;
        if (facets.status === 'stub' && !state.showStubs) hiddenStubTitles.push(title);
      }
    }

    countEl.textContent = `Showing ${visible} of ${cards.length} demonstrations.`;
    renderChips(state);

    // The dashed note names hidden stubs matching the active filters, so a
    // thin result set does not read as "the stockroom lacks it". Unfiltered
    // views skip it (it would name all 42), and the zero-result empty state
    // already explains hidden matches itself.
    const noteText =
      visible > 0 && activeFilterCount(state) > 0 ? hiddenStubNote(hiddenStubTitles) : '';
    stubNoteText.textContent = noteText;
    stubNoteEl.hidden = noteText === '';

    emptyEl.hidden = visible > 0;
    if (visible === 0) {
      const filters = activeFilterCount(state);
      const parts: string[] = [];
      if (filters > 0) {
        parts.push(
          `No demonstrations match ${filters === 1 ? 'this filter' : `all ${filters} filters`}.`,
        );
        if (lastChangedLabel) parts.push(`Try clearing "${lastChangedLabel}".`);
      } else {
        parts.push('No demonstrations to show.');
      }
      if (hiddenByDefault > 0) {
        parts.push(
          `${hiddenByDefault} matching ${hiddenByDefault === 1 ? 'record is' : 'records are'} hidden as stub or out of service; the "Records" toggles show them.`,
        );
      }
      emptyMessage.textContent = parts.join(' ');
    }

    const query = serializeState(state);
    const next = query === '' ? location.pathname : `${location.pathname}?${query}`;
    history.replaceState(null, '', next);
  };

  const refresh = async (): Promise<void> => {
    const state = readState();
    await runSearch(state.q);
    apply(state);
  };

  form.addEventListener('change', (event) => {
    const target = event.target;
    if (target instanceof HTMLInputElement && target.type === 'checkbox') {
      lastChangedLabel = target.closest('label')?.textContent?.trim() ?? '';
      // Checking a category reveals its subtopics. Open only, never close:
      // collapsing on uncheck could hide a still-checked subtopic filter.
      if (target.name === 'cat' && target.checked) {
        const details = target
          .closest('.cat-block')
          ?.querySelector<HTMLDetailsElement>('details[data-category]');
        if (details) details.open = true;
      }
    }
    void refresh();
  });

  // Removing a chip unchecks the control it mirrors; the next refresh
  // rebuilds the row from state, so chips can never drift from the form.
  chipsEl.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.active-chip');
    if (!button) return;
    const { param = '', value = '' } = button.dataset;
    const input = form.querySelector<HTMLInputElement>(
      `input[name="${param}"][value="${CSS.escape(value)}"]`,
    );
    if (input) input.checked = false;
    lastChangedLabel = '';
    void refresh();
  });

  clearAllButton.addEventListener('click', () => {
    for (const input of form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')) {
      if (input.name !== 'stubs' && input.name !== 'oos') input.checked = false;
    }
    lastChangedLabel = '';
    void refresh();
  });

  includeStubsButton.addEventListener('click', () => {
    const stubs = form.querySelector<HTMLInputElement>('input[name="stubs"]');
    if (stubs) stubs.checked = true;
    lastChangedLabel = '';
    void refresh();
  });

  let debounce: ReturnType<typeof setTimeout> | undefined;
  searchInput.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(() => {
      lastChangedLabel = 'the search text';
      void refresh();
    }, 150);
  });

  // Enter in the search box must not reload the page. The input lives in
  // the search band and joins the form via its form attribute, so implicit
  // submission still lands here.
  form.addEventListener('submit', (event) => event.preventDefault());

  // Restore linkable state from the URL, then apply.
  writeControls(parseState(location.search));
  void refresh();
</script>

<style>
  /* The search band spans the viewport under the masthead; the input
     itself stays on the content column grid. */
  .search-band {
    background: var(--panel);
    border-bottom: 1px solid var(--rule);
  }

  .search-inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: 0.7rem 1.25rem;
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  #q {
    flex: 1;
    min-width: 14rem;
    max-width: 40rem;
    font: inherit;
    /* 1rem, never less: below 16px iOS Safari zooms the page on focus
       (build-plan amendment 11). */
    font-size: 1rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--muted);
    border-radius: 2px;
    background: var(--paper);
    color: var(--ink);
  }

  .search-note {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .shell {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
  }

  /* ---- Facet sidebar ---- */

  .sidebar {
    flex: none;
    width: 16.5rem;
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 1rem 1rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  fieldset {
    border: none;
    margin: 0;
    padding: 0;
  }

  legend {
    padding: 0;
    margin-bottom: 0.45rem;
  }

  /* legend resists flex layout in some engines; the inner span does the
     work. The tick is the accent as a fill, per the theme contract. */
  .legend-inner {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--ink);
  }

  .legend-inner::before {
    content: '';
    width: 3px;
    height: 0.75rem;
    background: var(--accent);
    display: block;
  }

  fieldset label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    margin-bottom: 0.3rem;
  }

  fieldset input[type='checkbox'] {
    accent-color: var(--accent-text);
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .cat-block {
    margin-bottom: 0.2rem;
  }

  .cat-label {
    font-weight: 700;
  }

  .cat-topics {
    margin-left: 1.5rem;
  }

  .cat-topics summary {
    cursor: pointer;
    font-size: 0.78rem;
    color: var(--muted);
    padding: 0.1rem 0;
  }

  @media (hover: hover) {
    .cat-topics summary:hover {
      color: var(--ink);
    }
  }

  .topic-list {
    padding: 0.25rem 0 0.35rem 0.15rem;
    border-left: 1px solid var(--rule);
    padding-left: 0.7rem;
    margin: 0.1rem 0 0.2rem;
  }

  .topic-list label {
    font-size: 0.84rem;
    font-weight: 400;
  }

  /* ---- Course chips: real checkboxes wearing toggle-chip clothes ---- */

  .course-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .course-chip {
    position: relative;
    margin: 0;
  }

  .course-chip input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .course-chip span {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--muted);
    border-radius: 2px;
    color: var(--ink);
  }

  .course-chip:has(input:checked) span {
    background: var(--accent-text);
    border-color: var(--accent-text);
    color: var(--paper);
    font-weight: 600;
  }

  .course-chip:has(input:focus-visible) span {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }

  /* ---- Results column ---- */

  .results {
    flex: 1;
    min-width: 0;
  }

  .results-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
  }

  #count {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }

  .active-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .active-chip {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.5rem;
    background: var(--panel-2);
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 2px;
    cursor: pointer;
  }

  .active-chip .x {
    color: var(--accent-text);
    font-weight: 700;
  }

  .linklike {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: 0.83rem;
    color: var(--accent-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  #clear-all {
    margin-left: auto;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1.1rem;
  }

  .stub-note,
  .empty {
    border: 1px dashed var(--muted);
    border-radius: 2px;
    padding: 0.7rem 0.8rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .stub-note {
    margin: 1.1rem 0 0;
  }

  .stub-note .linklike {
    margin-left: 0.35rem;
  }

  .empty {
    border-width: 2px;
    padding: 1.25rem;
    max-width: 46rem;
  }

  .empty p {
    margin: 0;
