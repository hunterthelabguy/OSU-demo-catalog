---
// Placeholder index. The real index page, with demo cards, facets, and
// search, is phase 4 of docs/build-plan.md. Until then: a plain linked list,
// which also proves content flows from the collection to the deploy.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Chip from '../components/Chip.astro';

const demos = (await getCollection('demos')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<Base
  title="Physics Demonstration Catalog"
  description="A browsable catalog of physics lecture demonstrations."
>
  <main>
    <h1>Physics Demonstration Catalog</h1>
    <p>
      A browsable catalog of physics lecture demonstrations. Under
      construction: faceted browse and search arrive in a later phase; the
      records below are live now.
    </p>
    <h2>Records</h2>
    <ul class="records">
      {
        demos.map((demo) => (
          <li>
            <a href={`/demos/${demo.id}/`}>{demo.data.title}</a>
            <Chip label={demo.data.status} tone="stamp" />
          </li>
        ))
      }
    </ul>
    <p class="count">{demos.length} records so far.</p>
  </main>
</Base>

<style>
  h1 {
    font-size: 1.9rem;
  }

  h2 {
    font-size: 1.15rem;
    border-top: 1px solid var(--rule);
    padding-top: 0.9rem;
    margin-top: 1.75rem;
  }

  .records {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .records li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .count {
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
